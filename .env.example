DB_NAME=

#JWT
JWT_SECRET_KEY=
JWT_EXPIRATION=

# Mailtrap API - Email Sending
# For dev/testing: set MAILTRAP_SANDBOX=true and fill in your Mailtrap sandbox inbox ID
# (find it in Mailtrap dashboard -> Email Testing -> your inbox -> URL: /inboxes/<ID>)
# For production: set MAILTRAP_SANDBOX=false and use a verified sender domain
MAILTRAP_TOKEN=
MAILTRAP_SANDBOX=
MAILTRAP_INBOX_ID=
MAILTRAP_SENDER_EMAIL=
MAILTRAP_SENDER_NAME= 

# Frontend URL for email verification links
FRONTEND_URL=

#Redis Credentials
REDIS_HOST=
REDIS_PORT=
REDIS_USER=
REDIS_PASSWORD=